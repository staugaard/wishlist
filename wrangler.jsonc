{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishlist",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishlist-db",
      "database_id": "7537f483-4755-4325-b5b5-05a26e756fa6",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "wishlist.season4.app", "custom_domain": true }],
  // Keep workers.dev alive alongside the custom domain — PR preview URLs depend on it.
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true
  }
}
