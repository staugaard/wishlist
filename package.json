{
  "name": "wishlist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "typecheck": "wrangler types --env-interface CloudflareBindings && tsc --noEmit && tsc -p tsconfig.client.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "./scripts/smoke.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wishlist-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wishlist-db --remote",
    "db:seed": "wrangler d1 execute wishlist-db --local --file=./scripts/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "packageManager": "pnpm@11.21.0"
}
